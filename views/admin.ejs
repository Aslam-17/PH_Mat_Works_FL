<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Admin Console - Mats System</title>
  <link rel="stylesheet" href="/styles/styles.css" />
</head>
<body>
  <header class="topbar">
    <h2>Admin Console</h2>
    <div class="header-right">
      <span><%= user.username %> (Admin)</span>
      <a href="/auth/logout" class="btn small">Logout</a>
    </div>
  </header>

  <main class="container grid-two">
    <!-- Left: Add Work -->
    <section class="card">
      <h3>Add Work</h3>

      <form id="addWorkForm">
        <label for="workTypeSelect">Select Predetermined Work</label>
        <select id="workTypeSelect" name="work_type_id">
          <option value="">-- choose --</option>
          <% workTypes.forEach(function(w){ %>
            <option value="<%= w.id %>"><%= w.name %></option>
          <% }) %>
          <option value="__new">-- Add new work type --</option>
        </select>

        <div id="newWorkTypeBlock" class="hidden">
          <label for="newWorkName">New Work Name</label>
          <input id="newWorkName" name="newWorkName" type="text" />
        </div>

        <label for="qty">Quantity</label>
        <input id="qty" name="qty" type="number" min="1" value="1" required />

        <label for="deadline">Deadline</label>
        <input id="deadline" name="deadline" type="datetime-local" />

        <label for="customer">Customer Name</label>
        <input id="customer" name="customer" type="text" />

        <button class="btn" type="submit">Create & Add</button>
      </form>
    </section>

    <!-- Right: In-progress / All works -->
    <section class="card">
      <h3>Works (In Progress & Pending)</h3>
      <div id="tasksList" class="tasks-list">
        <!-- dynamically filled -->
      </div>
    </section>
  </main>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/client.js"></script>
</body>
</html>
